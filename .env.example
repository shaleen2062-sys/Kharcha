OCR_ENGINE=auto
KHARCHA_DATE_ORDER=mdy
READER_TOKEN=local-reader-token

NODE_ENV=production
PORT=4000
PUBLIC_BASE_URL=http://localhost:4000
CORS_ORIGINS=
AUTH_MODE=firebase
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/kharcha
APP_TZ=Asia/Kathmandu
STORAGE_MODE=supabase
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=receipts
SUPABASE_URL=https://your-project.supabase.co
URL_SIGNING_SECRET=replace-with-a-long-random-secret
READER=http
READER_URL=http://reader:8000
READER_TIMEOUT_MS=120000
READER_MIN_CONFIDENCE=0.6
