NODE_ENV=development
PORT=4000
PUBLIC_BASE_URL=http://localhost:4000

AUTH_MODE=firebase

FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/dbname

# ---- Added for receipts, budgets and the AI reader ----
# What "this month" means for budgets and the dashboard
APP_TZ=Asia/Kathmandu

# Receipt photo storage: local (a folder, for development) | supabase (private bucket) | memory (tests)
STORAGE_MODE=local
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10
# Signs photo links (STORAGE_MODE=local). REQUIRED in production. Make one:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
URL_SIGNING_SECRET=
IMAGE_URL_TTL_SECONDS=3600
# STORAGE_MODE=supabase
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_BUCKET=receipts

# The AI reader (../reader). manual = no AI: the user types each receipt in (the app still works).
READER=manual
# READER=http
# READER_URL=http://localhost:8000
# READER_TOKEN=            # same value as READER_TOKEN on the reader service
# READER_TIMEOUT_MS=120000
# READER_MIN_CONFIDENCE=0.7   # below this a receipt always goes to the review screen

